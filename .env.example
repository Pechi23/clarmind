# ClarMind environment variables (copy to .env — .env is gitignored)

# --- AI (Gemini) ---
# PREFERRED (secure): point the app at the Cloudflare Worker proxy that holds the
# key server-side (see proxy/README.md). When this is set, the key below is not used
# and is NOT bundled into the app.
# EXPO_PUBLIC_AI_PROXY_URL=https://clarmind-ai-proxy.<your-subdomain>.workers.dev

# DEV ONLY: direct Gemini key. This gets bundled into the APK — do NOT use for a
# public release; use the proxy above instead.
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-key-here

# --- Freemium testing ---
# Set to 1 to unlock all premium features (numerology, birth chart, 50 AI/day)
# without a subscription, while the paywall is still being finalized.
# EXPO_PUBLIC_PREMIUM_BYPASS=1
