{
  "expo": {
    "name": "Stillnova",
    "slug": "clarmind",
    "version": "1.7.2",
    "scheme": "clarmind",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0c29"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.stillnova.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": ["en", "ro", "it", "fr", "es", "de", "pt"],
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f0c29"
      },
      "package": "com.stillnova.app",
      "versionCode": 9,
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "expo-splash-screen",
      "expo-secure-store",
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Stillnova uses the microphone so you can talk to Clara.",
          "speechRecognitionPermission": "Stillnova uses speech recognition to turn your voice into text for Clara."
        }
      ]
    ]
  }
}
